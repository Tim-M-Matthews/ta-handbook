{
  "version": "1",
  "media_path": "/public",
  "ssg_framework": "astro",
  "frontmatter_format": "yaml",
  "publishing_mode": "direct_publish",
  "collections": [
    {
      "name": "Pages",
      "git_path": "/content/pages/",
      "file_extension": ".md",
      "filename_pattern": "-",
      "collection_type": "grouped",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title",
          "required": true,
        },
        {
          "name": "order",
          "type": "number",
          "label": "Order",
        },
        {
          "name": "description",
          "type": "text",
          "label": "Description",
        },
        {
          "name": "category",
          "type": "text",
          "label": "Category (opt  ional, legacy)",
        },
        {
          "name": "status",
          "type": "select",
          "label": "Status",
          "options": [
            { "value": "todo", "label": "To-do" },
            { "value": "draft", "label": "Draft" },
            { "value": "complete", "label": "Complete" },
          ],
          "color": "purple",
        },
        {
          "name": "roles",
          "type": "multiselect",
          "label": "Roles",
          "options": ["clinical", "staff", "admin"],
          "color": "blue",
        },
      ],
    },
  ],
}
